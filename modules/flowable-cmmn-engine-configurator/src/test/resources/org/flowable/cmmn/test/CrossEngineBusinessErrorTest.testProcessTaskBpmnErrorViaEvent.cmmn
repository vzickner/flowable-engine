<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/CMMN/20151109/MODEL"
             xmlns:flowable="http://flowable.org/cmmn"
             targetNamespace="http://flowable.org/cmmn">
    <case id="testProcessTaskFaultViaEvent" name="Test ProcessTask Fault Via Event">
        <casePlanModel id="casePlanModel" name="Case plan model" autoComplete="true">

            <planItem id="planItemProcess" name="Process Task" definitionRef="processTask" />

            <planItem id="planItemSendEvent" name="Send Event" definitionRef="sendEventTask">
                <itemControl>
                    <manualActivationRule />
                </itemControl>
            </planItem>

            <planItem id="planItemB" name="B" definitionRef="humanTaskB">
                <entryCriterion id="entryB" sentryRef="sentryOnProcessFault" />
            </planItem>

            <sentry id="sentryOnProcessFault">
                <planItemOnPart id="onPartProcess" sourceRef="planItemProcess">
                    <standardEvent>fault</standardEvent>
                </planItemOnPart>
            </sentry>

            <processTask id="processTask" name="Process Task" processRef="throwErrorProcess" isBlocking="true">
                <extensionElements>
                    <flowable:in source="correlationKey" target="correlationKey" />
                </extensionElements>
            </processTask>

            <task id="sendEventTask" name="Send Event" flowable:type="send-event">
                <extensionElements>
                    <flowable:eventType>triggerFaultEvent</flowable:eventType>
                    <flowable:systemChannel />
                    <flowable:eventInParameter source="${correlationKey}" target="correlationKey" />
                </extensionElements>
            </task>

            <humanTask id="humanTaskB" name="B" />
        </casePlanModel>
    </case>
    <process id="throwErrorProcess" externalRef="throwBpmnErrorViaEventProcess" />
</definitions>
